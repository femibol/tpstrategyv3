//@version=6
// Crypto Mean Reversion — faithful port of tpstrategyv3 bot/strategies/mean_reversion.py
// (crypto path). Run on 5-minute charts of Coinbase pairs (e.g. COINBASE:NEARUSD,
// COINBASE:AAVEUSD, COINBASE:ALGOUSD).
//
// Bot logic ported:
//   Entry (any path, all need reversal candle + trend gate):
//     P1: Z<=-1.2 AND RSI14<45 AND vol>=1.1x
//     P2: Z<=-1.2 AND close<=lowerBB AND vol>1.3x
//     P3: RSI14<45 AND close<=lowerBB AND vol>1.5x
//   Reversal candle (crypto): PREVIOUS bar close >= open
//   Trend gate: close >= +2% vs 3 days ago (864 x 5m bars)
//   Stop: entry - 2*ATR14 | Target: max(SMA20, entry + 2*risk)
//   Mean-cross exit: Z >= +0.3 | Overbought exit: Z>=1.5 AND RSI>55
//   Time exit: 20 bars (~100 min) | Min hold: 1 bar (5-min rule)
// NOT ported (engine-level): profit ladder partials, breakeven bump, trailing
// tiers, daily-loss guard, portfolio risk caps. Backtest is therefore slightly
// CONSERVATIVE on winners vs the live bot.

strategy("Crypto Mean Reversion (bot port)", overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=10,
     commission_type=strategy.commission.percent, commission_value=0.3,
     slippage=2, calc_on_every_tick=false, process_orders_on_close=true,
     max_labels_count=500)

// === Preset — overrides everything below except the date window ===
preset = input.string("Bot live config", "Setting chain",
     options=["Bot live config", "Custom", "Strict quality", "Loose (more trades)", "No trend gate"])

// === Backtest window ===
useRange   = input.bool(false, "Limit backtest to date range", group="Backtest window")
rangeStart = input.time(timestamp("1 Jan 2025 00:00 +0000"), "Start", group="Backtest window")
rangeEnd   = input.time(timestamp("1 Jan 2027 00:00 +0000"), "End", group="Backtest window")
inRange    = not useRange or (time >= rangeStart and time <= rangeEnd)

// === Manual inputs (active when preset = Custom; defaults mirror the bot) ===
lookback     = input.int(20,    "Lookback (SMA / Z / BB / volume)")
entryZIn     = input.float(-1.2, "Entry Z-score", step=0.1)
exitZIn      = input.float(0.3,  "Mean-cross exit Z", step=0.1)
rsiOSIn      = input.float(45,   "RSI oversold")
rsiOB        = input.float(55,   "RSI overbought")
bbStd        = input.float(2.0,  "Bollinger std", step=0.1)
volFloor1In  = input.float(1.1,  "Vol floor — path 1 (Z+RSI)", step=0.1)
volFloor2    = input.float(1.3,  "Vol floor — path 2 (Z+BB)", step=0.1)
volFloor3    = input.float(1.5,  "Vol floor — path 3 (RSI+BB)", step=0.1)
trendBars    = input.int(864,   "Trend gate lookback bars (864 = 3d on 5m)")
trendMinIn   = input.float(2.0,  "Trend gate min % gain", step=0.5)
atrMult      = input.float(2.0,  "ATR stop multiple", step=0.5)
maxHoldBars  = input.int(20,    "Time exit (bars)")
minHoldBars  = input.int(1,     "Min hold (bars) before signal exits")
useTrendIn   = input.bool(true, "Enable 3-day trend gate")

// Preset chains. "Bot live config" = exactly what runs on the VPS today.
// "Strict quality"  — deeper dip, stronger volume, stronger tape required.
// "Loose"           — more trades, shallower dips; shows what looseness costs.
// "No trend gate"   — isolates how much the 3-day trend gate is worth.
isStrict = preset == "Strict quality"
isLoose  = preset == "Loose (more trades)"
isNoGate = preset == "No trend gate"
isCustom = preset == "Custom"

entryZ      = isCustom ? entryZIn    : isStrict ? -1.5 : isLoose ? -1.0 : -1.2
exitZ       = isCustom ? exitZIn     : 0.3
rsiOS       = isCustom ? rsiOSIn     : isStrict ? 40.0 : isLoose ? 50.0 : 45.0
volFloor1   = isCustom ? volFloor1In : isStrict ? 1.3  : isLoose ? 1.0  : 1.1
trendMinPct = isCustom ? trendMinIn  : isStrict ? 3.0  : isLoose ? 1.0  : 2.0
useTrendGate= isCustom ? useTrendIn  : not isNoGate

// === Indicators ===
smaVal   = ta.sma(close, lookback)
sd       = ta.stdev(close, lookback)
z        = sd > 0 ? (close - smaVal) / sd : 0.0
rsiVal   = ta.rsi(close, 14)
bbLower  = smaVal - bbStd * sd
bbUpper  = smaVal + bbStd * sd
volAvg   = ta.sma(volume, lookback)
volRatio = volAvg > 0 ? volume / volAvg : 0.0
atrVal   = ta.atr(14)

// Crypto reversal candle = previous bar green or doji
reversal = close[1] >= open[1]

// 3-day trend gate
refPx    = close[trendBars]
trendPct = not na(refPx) and refPx > 0 ? (close - refPx) / refPx * 100 : na
trendOK  = not useTrendGate or na(trendPct) or trendPct >= trendMinPct  // falls open like the bot

// === Entry paths ===
zOK    = z <= entryZ
rsiLow = rsiVal < rsiOS
atLBB  = close <= bbLower

path1 = zOK and rsiLow and reversal and volRatio >= volFloor1
path2 = zOK and atLBB  and reversal and volRatio >  volFloor2
path3 = rsiLow and atLBB and reversal and volRatio > volFloor3
entrySig = (path1 or path2 or path3) and trendOK and inRange

var float stopPx   = na
var float tpPx     = na
var int   entryBar = na

if entrySig and strategy.position_size == 0
    stopPx   := close - atrMult * atrVal
    tpPx     := math.max(smaVal, close + 2.0 * (close - stopPx))
    entryBar := bar_index
    strategy.entry("MR Long", strategy.long,
         alert_message='{"ticker":"{{ticker}}","action":"buy","price":{{close}}}')

// === Exits ===
inPos     = strategy.position_size > 0
heldBars  = inPos and not na(entryBar) ? bar_index - entryBar : 0
minHoldOK = heldBars >= minHoldBars

if inPos
    strategy.exit("Bracket", from_entry="MR Long", stop=stopPx, limit=tpPx)
    if minHoldOK and z >= exitZ
        strategy.close("MR Long", comment="mean-cross",
             alert_message='{"ticker":"{{ticker}}","action":"sell","price":{{close}}}')
    else if minHoldOK and z >= 1.5 and rsiVal > rsiOB
        strategy.close("MR Long", comment="overbought",
             alert_message='{"ticker":"{{ticker}}","action":"sell","price":{{close}}}')
    else if heldBars >= maxHoldBars
        strategy.close("MR Long", comment="time_exit",
             alert_message='{"ticker":"{{ticker}}","action":"sell","price":{{close}}}')
    else if useRange and time > rangeEnd
        strategy.close("MR Long", comment="range_end")

// === Trade labels (visible entries / exits) ===
justEntered = strategy.position_size > 0 and strategy.position_size[1] == 0
justExited  = strategy.position_size == 0 and strategy.position_size[1] > 0

if justEntered
    pathTxt = path1[1] ? "Z+RSI" : path2[1] ? "Z+BB" : "RSI+BB"
    label.new(bar_index, low,
         "▲ MR LONG " + pathTxt + "\n@ " + str.tostring(strategy.position_avg_price, format.mintick) +
         "  Z=" + str.tostring(z[1], "#.##"),
         style=label.style_label_up, color=color.new(color.green, 10),
         textcolor=color.white, size=size.small)
if justExited
    lastP = strategy.closedtrades > 0 ? strategy.closedtrades.profit(strategy.closedtrades - 1) : na
    isWin = not na(lastP) and lastP >= 0
    exitWhy = close <= nz(stopPx, -1e10) ? "stop" :
         close >= nz(tpPx, 1e10) ? "target" :
         z >= 1.5 and rsiVal > rsiOB ? "overbought" :
         z >= exitZ ? "mean-cross" : "time/range"
    label.new(bar_index, high,
         (na(lastP) ? "EXIT" : (isWin ? "✔ WIN +$" : "✖ LOSS -$") + str.tostring(math.abs(lastP), "#.##")) +
         "\n" + exitWhy + " @ " + str.tostring(close, format.mintick),
         style=label.style_label_down,
         color=isWin ? color.new(color.green, 10) : color.new(color.red, 10),
         textcolor=color.white, size=size.small)

// === Visuals ===
plot(smaVal,  "SMA20",   color=color.new(color.orange, 0))
plot(bbLower, "BB lower", color=color.new(color.blue, 60))
plot(bbUpper, "BB upper", color=color.new(color.blue, 60))
plot(inPos ? stopPx : na, "Stop",   color=color.new(color.red, 30),  style=plot.style_linebr)
plot(inPos ? tpPx   : na, "Target", color=color.new(color.green, 30), style=plot.style_linebr)
bgcolor(entrySig ? color.new(color.green, 85) : na)
